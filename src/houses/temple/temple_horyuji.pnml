// Ground

        spriteset (spr_temple_horyuji_ground_norm, "src/houses/temple/gfx/horyuji/ground_norm.png") {template_ground_norm(100,1)}
        spriteset (spr_temple_horyuji_ground_snow, "src/houses/temple/gfx/horyuji/ground_snow.png") {template_ground_norm(100,1)}

// Buildings

    // L
        spriteset (spr_temple_horyuji_L_norm, "src/houses/temple/gfx/horyuji/norm.png") {template_house_norm(100,1)}
        spriteset (spr_temple_horyuji_L_snow, "src/houses/temple/gfx/horyuji/snow.png") {template_house_norm(100,1)}

// Trees

        spriteset (spr_temple_horyuji_trees, "src/houses/temple/gfx/horyuji/trees.png") {template_child_norm(100,1)}


// Spritelayouts for temple_horyuji

// E variant | L level | Norm
    spritelayout sprlay_temple_horyuji_e_L_norm {
        ground {
            sprite:        spr_temple_horyuji_ground_norm(2);
        }
        building {
            sprite:        spr_temple_horyuji_L_norm (2);
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(1);
        }
        childsprite { // trees
            sprite:        spr_temple_horyuji_trees (2); 
        }
    }

// E variant | L level | Snow
    spritelayout sprlay_temple_horyuji_e_L_snow {
        ground {
            sprite:        spr_temple_horyuji_ground_snow(2);
        }
        building {
            sprite:        spr_temple_horyuji_L_snow (2);
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(1);
        }
        childsprite { // trees
            sprite:        spr_temple_horyuji_trees (2); 
        }
    }

