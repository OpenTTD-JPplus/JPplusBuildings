// Random Switches
    // Building Colours
        switch (FEAT_HOUSES, SELF, temple_horyuji_build_clr_new, getbits(random_bits, 1, 2)) {
            0:  return 62;
            1:  return 73;
            2:  return 78;
                return 92;
        }


// Spritelayout Switches
    // e
        // L
            switch (FEAT_HOUSES,SELF, switch_temple_horyuji_e_sprites, [ 
                STORE_TEMP(temple_horyuji_build_clr_new(), 1),
                terrain_type == TILETYPE_SNOW])
                {1: sprlay_temple_horyuji_e_L_snow; sprlay_temple_horyuji_e_L_norm; } 
    // n
        // L
            switch (FEAT_HOUSES,SELF, switch_temple_horyuji_n_sprites, [ 
                STORE_TEMP(temple_horyuji_build_clr_new(), 1),
                terrain_type == TILETYPE_SNOW])
                {1: sprlay_temple_horyuji_n_L_snow; sprlay_temple_horyuji_n_L_norm; } 
    // s
        // L
            switch (FEAT_HOUSES,SELF, switch_temple_horyuji_s_sprites, [ 
                STORE_TEMP(temple_horyuji_build_clr_new(), 1),
                terrain_type == TILETYPE_SNOW])
                {1: sprlay_temple_horyuji_s_L_snow; sprlay_temple_horyuji_s_L_norm; } 
    // w
        // L
            switch (FEAT_HOUSES,SELF, switch_temple_horyuji_w_sprites, [ 
                STORE_TEMP(temple_horyuji_build_clr_new(), 1),
                terrain_type == TILETYPE_SNOW])
                {1: sprlay_temple_horyuji_w_L_snow; sprlay_temple_horyuji_w_L_norm; } 

// Item Block
    item(FEAT_HOUSES, item_temple_horyuji, 224, HOUSE_SIZE_2X2){
        property {
            substitute:              20;
            name:                    string(NAME_TEMPLE_HORYUJI);
            population:              100;
            accepted_cargos:         [[PASS, 8],[MAIL, 1],[FOOD, 2]];
            local_authority_impact:  80;
            removal_cost_multiplier: 80;
            probability:             3;
            years_available:         [1700,0xFFFF];
            minimum_lifetime:        20;
            availability_mask:       [ALL_TOWNZONES, bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, ABOVE_SNOWLINE, CLIMATE_TROPIC)];
            building_class:          1;
            building_flags:          bitmask(HOUSE_FLAG_NOT_SLOPED,HOUSE_FLAG_PROTECTED);
        }
        graphics {
            graphics_north:          switch_temple_horyuji_n_sprites;
            graphics_east:           switch_temple_horyuji_e_sprites;
            graphics_west:           switch_temple_horyuji_w_sprites;
            graphics_south:          switch_temple_horyuji_s_sprites;
            construction_check:      switch_temple_SWroad_con_check;
            cargo_production:        func_produce(10,2);
        }
    }