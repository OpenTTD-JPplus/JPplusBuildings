// Random Switches
    // House Colours
        switch (FEAT_HOUSES, SELF, waterfront_halfpath_house_new, getbits(random_bits, 1, 4)) {
            0:  return 23;
            1:  return 31;
            2:  return 32;
            3:  return 34;
            4:  return 45;
