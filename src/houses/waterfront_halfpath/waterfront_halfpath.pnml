// Spritelayouts for waterfront_halfpath

// H variant | L level | Norm
    spritelayout sprlay_waterfront_halfpath_h_L_diagonal_norm {
        ground {
            sprite:        LOAD_TEMP(96) + LOAD_TEMP(98);
        }
        building {
            sprite:        spr_waterfront_halfpath_h_L_diagonal_norm (LOAD_TEMP(0));
            always_draw:  1;
        }
        childsprite { // found
            sprite:        spr_waterfront_halfpath_h_diagonal_found (LOAD_TEMP(20)); 
            always_draw:  1;
        }
        childsprite { // house
            sprite:        spr_waterfront_halfpath_h_diagonal_house_norm (LOAD_TEMP(22)); 
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(23);
        }
        childsprite { // front
            sprite:        spr_waterfront_halfpath_h_diagonal_front_norm (LOAD_TEMP(18)); 
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(19);
        }
        childsprite { // fence
            sprite:        spr_waterfront_halfpath_h_diagonal_fence (LOAD_TEMP(4)); 
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(5);
        }
    }

// H variant | L level | Norm
    spritelayout sprlay_waterfront_halfpath_h_L_oneup_norm {
        ground {
            sprite:        GROUNDSPRITE_WATER;
        }
        building {
            sprite:        spr_waterfront_halfpath_h_L_oneup_norm (LOAD_TEMP(0));
