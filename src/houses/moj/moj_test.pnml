// Random Switches
    // Building Colours
        switch (FEAT_HOUSES, SELF, moj_build_clr_new, getbits(random_bits, 1, 2)) {
            0:  return 40;
            1:  return 44;
            2:  return 53;
                return 62;
        }


// Spritelayout Switches
            switch (FEAT_HOUSES,SELF, switch_moj_sprites, [ 
                STORE_TEMP(moj_build_clr_new(), 1), 
                STORE_TEMP(ColidasGround(), 2),
                STORE_TEMP(ColidasBuilding(), 0),
                SpriteDirectionsABCDENSW()])
                {
                    1: sprlay_moj_b_L_norm;
                    2: sprlay_moj_e_L_norm;
                    3: sprlay_moj_n_L_norm;
                    4: sprlay_moj_s_L_norm;
                    5: sprlay_moj_w_L_norm;
                    6: sprlay_moj_c_L_norm;
                    7: sprlay_moj_d_L_norm;
                    sprlay_moj_a_L_norm;
                }

// Item Block
    item(FEAT_HOUSES, item_moj, 96, HOUSE_SIZE_1X1){
        property {
            substitute:              27;
            name:                    string(NAME_MOJ);
            population:              150;
            accepted_cargos:         [[PASS, 4],[MAIL, 2], [GOOD, 2]];
            local_authority_impact:  80;
            removal_cost_multiplier: 80;
            probability:             5;
            years_available:         [1900,1950];
            minimum_lifetime:        15;
            availability_mask:       [bitmask(TOWNZONE_CENTRE), bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, ABOVE_SNOWLINE, CLIMATE_TROPIC)];
            building_class:          99;
        }
        graphics {
            default:                 switch_moj_sprites;
            construction_check:      switch_shirokiya_con_check;
            cargo_production:        func_produce(14,5);
            protection:              switch_shirokiya_protection;
        }
    }
