// Spritelayouts for moj

// A variant | L level | Norm
    spritelayout sprlay_moj_a_L_norm {
        ground {
            sprite:        spr_moj_a_ground_norm(LOAD_TEMP(2));
        }
        building {
            sprite:        spr_moj_a_L_norm (LOAD_TEMP(0));
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(1);
        }
        childsprite { // fence
            sprite:        spr_moj_a_fence_norm (LOAD_TEMP(0)); 
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(1);
            hide_sprite:  construction_state != 3;
        }
        childsprite { // trees
            sprite:        spr_moj_a_trees (LOAD_TEMP(10)); 
            hide_sprite:  construction_state != 3;
        }
    }

