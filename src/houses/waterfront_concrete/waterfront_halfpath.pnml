// Buildings

    // L
        spriteset (spr_new_building_h_L_diagonal_norm, "src/houses/waterfront_concrete/gfx/norm.png") {template_house_norm(80,1)}
        spriteset (spr_new_building_h_L_diagonal_snow, "src/houses/waterfront_concrete/gfx/snow.png") {template_house_norm(80,1)}
        spriteset (spr_new_building_h_L_oneup_norm, "src/houses/waterfront_concrete/gfx/norm.png") {template_house_norm(80,2)}
        spriteset (spr_new_building_h_L_oneup_snow, "src/houses/waterfront_concrete/gfx/snow.png") {template_house_norm(80,2)}
        spriteset (spr_new_building_h_L_valley_norm, "src/houses/waterfront_concrete/gfx/norm.png") {template_house_norm(80,3)}
        spriteset (spr_new_building_h_L_valley_snow, "src/houses/waterfront_concrete/gfx/snow.png") {template_house_norm(80,3)}
        spriteset (spr_new_building_h_L_onedown_norm, "src/houses/waterfront_concrete/gfx/norm.png") {template_house_norm(80,4)}
        spriteset (spr_new_building_h_L_onedown_snow, "src/houses/waterfront_concrete/gfx/snow.png") {template_house_norm(80,4)}


// Spritelayouts for waterfront_halfpath

// H variant | L level | Norm
    spritelayout sprlay_waterfront_halfpath_h_L_diagonal_norm {
        ground {
            sprite:        LOAD_TEMP(96) + LOAD_TEMP(98);
        }
        building {
            sprite:        spr_waterfront_halfpath_h_L_diagonal_norm (LOAD_TEMP(0));
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(1);
            always_draw:  1;
        }
    }

// H variant | L level | Norm
    spritelayout sprlay_waterfront_halfpath_h_L_oneup_norm {
        ground {
            sprite:        GROUNDSPRITE_WATER;
        }
        building {
            sprite:        spr_waterfront_halfpath_h_L_oneup_norm (LOAD_TEMP(0));
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(1);
            always_draw:  1;
        }
    }

// H variant | L level | Norm
    spritelayout sprlay_waterfront_halfpath_h_L_valley_norm {
        ground {
            sprite:        LOAD_TEMP(96) + LOAD_TEMP(98);
        }
        building {
            sprite:        spr_waterfront_halfpath_h_L_valley_norm (LOAD_TEMP(0));
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(1);
            always_draw:  1;
        }
    }

// H variant | L level | Norm
    spritelayout sprlay_waterfront_halfpath_h_L_onedown_norm {
        ground {
            sprite:        LOAD_TEMP(96) + LOAD_TEMP(98);
        }
        building {
            sprite:        spr_waterfront_halfpath_h_L_onedown_norm (LOAD_TEMP(0));
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(1);
            always_draw:  1;
        }
