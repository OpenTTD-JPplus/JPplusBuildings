// H variant | L level | Snow
    spritelayout sprlay_waterfront_halfpath_h_L_onedown_snow {
        ground {
            sprite:        LOAD_TEMP(96) + LOAD_TEMP(98);
        }
        building {
            sprite:        spr_waterfront_halfpath_h_L_onedown_snow (LOAD_TEMP(0));
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(1);
            always_draw:  1;
        }
