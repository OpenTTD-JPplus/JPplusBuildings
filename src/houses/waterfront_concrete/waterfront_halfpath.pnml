// H variant | L level | Snow
    spritelayout sprlay_waterfront_halfpath_h_L_diagonal_snow {
        ground {
            sprite:        LOAD_TEMP(96) + LOAD_TEMP(98);
        }
        building {
            sprite:        spr_waterfront_halfpath_h_L_diagonal_snow (LOAD_TEMP(0));
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(1);
            always_draw:  1;
        }
    }

// H variant | L level | Snow
    spritelayout sprlay_waterfront_halfpath_h_L_oneup_snow {
        ground {
            sprite:        GROUNDSPRITE_WATER;
        }
        building {
            sprite:        spr_waterfront_halfpath_h_L_oneup_snow (LOAD_TEMP(0));
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(1);
            always_draw:  1;
        }
    }

// H variant | L level | Snow
    spritelayout sprlay_waterfront_halfpath_h_L_valley_snow {
        ground {
            sprite:        LOAD_TEMP(96) + LOAD_TEMP(98);
        }
        building {
            sprite:        spr_waterfront_halfpath_h_L_valley_snow (LOAD_TEMP(0));
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(1);
            always_draw:  1;
        }
