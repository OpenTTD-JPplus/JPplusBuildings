        ground {
            sprite:        spr_tokyo_tower_q_ground_norm(2);
        }
        building {
            sprite:        spr_tokyo_tower_q_norm (2);
        }
    }

// E variant | Q level | Snow
    spritelayout sprlay_tokyo_tower_e_q_snow {
