// Spritelayout Switches
    // e
        // p
            switch (FEAT_HOUSES,SELF, switch_tokyo_tower_e_p_sprites,
                terrain_type == TILETYPE_SNOW)
                {1: sprlay_tokyo_tower_e_p_snow; sprlay_tokyo_tower_e_p_norm; }
        // q
            switch (FEAT_HOUSES,SELF, switch_tokyo_tower_e_q_sprites,
                terrain_type == TILETYPE_SNOW)
                {1: sprlay_tokyo_tower_e_q_snow; sprlay_tokyo_tower_e_q_norm; }
    // n
        // p
            switch (FEAT_HOUSES,SELF, switch_tokyo_tower_n_p_sprites,
                terrain_type == TILETYPE_SNOW)
                {1: sprlay_tokyo_tower_n_p_snow; sprlay_tokyo_tower_n_p_norm; }
        // q
            switch (FEAT_HOUSES,SELF, switch_tokyo_tower_n_q_sprites,
                terrain_type == TILETYPE_SNOW)
                {1: sprlay_tokyo_tower_n_q_snow; sprlay_tokyo_tower_n_q_norm; }
    // s
        // p
            switch (FEAT_HOUSES,SELF, switch_tokyo_tower_s_p_sprites,
                terrain_type == TILETYPE_SNOW)
                {1: sprlay_tokyo_tower_s_p_snow; sprlay_tokyo_tower_s_p_norm; }
        // q
            switch (FEAT_HOUSES,SELF, switch_tokyo_tower_s_q_sprites,
                terrain_type == TILETYPE_SNOW)
                {1: sprlay_tokyo_tower_s_q_snow; sprlay_tokyo_tower_s_q_norm; }
    // w
        // p
            switch (FEAT_HOUSES,SELF, switch_tokyo_tower_w_p_sprites,
                terrain_type == TILETYPE_SNOW)
                {1: sprlay_tokyo_tower_w_p_snow; sprlay_tokyo_tower_w_p_norm; }
        // q
            switch (FEAT_HOUSES,SELF, switch_tokyo_tower_w_q_sprites,
                terrain_type == TILETYPE_SNOW)
                {1: sprlay_tokyo_tower_w_q_snow; sprlay_tokyo_tower_w_q_norm; }


// Level Selection     
    switch (FEAT_HOUSES, SELF, switch_tokyo_tower_e_sprites, getbits(random_bits, 0, 1)) {         
        0: switch_tokyo_tower_e_p_sprites;             
             switch_tokyo_tower_e_q_sprites;     
    } 

    switch (FEAT_HOUSES, SELF, switch_tokyo_tower_n_sprites, getbits(random_bits, 0, 1)) {         
        0: switch_tokyo_tower_n_p_sprites;             
             switch_tokyo_tower_n_q_sprites;     
    } 

    switch (FEAT_HOUSES, SELF, switch_tokyo_tower_s_sprites, getbits(random_bits, 0, 1)) {         
        0: switch_tokyo_tower_s_p_sprites;             
             switch_tokyo_tower_s_q_sprites;     
    } 

    switch (FEAT_HOUSES, SELF, switch_tokyo_tower_w_sprites, getbits(random_bits, 0, 1)) {         
        0: switch_tokyo_tower_w_p_sprites;             
             switch_tokyo_tower_w_q_sprites;     
    } 



// Name Switches

    switch (FEAT_HOUSES, SELF, switch_tokyo_tower_name, getbits(random_bits, 0, 1) ){
        0: return string(NAME_TOKYO_TOWER); // p 
        return string(NAME_SAPPORO_TV_TOWER); // q 
    }

// Item Block
    item(FEAT_HOUSES, item_tokyo_tower, 220, HOUSE_SIZE_2X2){
        property {
            substitute:              20;
            population:              200;
            accepted_cargos:         [[PASS, 8],[MAIL, 4],[GOOD, 4]];
            local_authority_impact:  80;
            removal_cost_multiplier: 80;
            probability:             5;
            years_available:         [1958,0xFFFF];
            minimum_lifetime:        25;
            availability_mask:       [bitmask(TOWNZONE_CENTRE), bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, ABOVE_SNOWLINE, CLIMATE_TROPIC)];
            building_class:          5;
            building_flags:          bitmask(HOUSE_FLAG_NOT_SLOPED,HOUSE_FLAG_PROTECTED);
        }
        graphics {
            graphics_north:          switch_tokyo_tower_n_sprites;
            graphics_east:           switch_tokyo_tower_e_sprites;
            graphics_west:           switch_tokyo_tower_w_sprites;
            graphics_south:          switch_tokyo_tower_s_sprites;
            name:                    switch_tokyo_tower_name;
            construction_check:      switch_skyscraper_con_check;
            cargo_production:        func_produce(24,10);
        }
    }