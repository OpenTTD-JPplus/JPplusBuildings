// Ground

        spriteset (spr_tokyo_tower_p_ground_norm, "src/houses/tokyo_tower/gfx/ground_norm_tokyo.png") {template_ground_norm(255,1)}
        spriteset (spr_tokyo_tower_p_ground_snow, "src/houses/tokyo_tower/gfx/ground_snow_tokyo.png") {template_ground_norm(255,1)}
        spriteset (spr_tokyo_tower_q_ground_norm, "src/houses/tokyo_tower/gfx/ground_norm_sapporo.png") {template_ground_norm(255,1)}
        spriteset (spr_tokyo_tower_q_ground_snow, "src/houses/tokyo_tower/gfx/ground_snow_sapporo.png") {template_ground_norm(255,1)}

// Buildings

    // P
        spriteset (spr_tokyo_tower_p_norm, "src/houses/tokyo_tower/gfx/norm_tokyo.png") {template_house_norm(255,1)}
        spriteset (spr_tokyo_tower_p_snow, "src/houses/tokyo_tower/gfx/norm_tokyo.png") {template_house_norm(255,1)}

    // Q
        spriteset (spr_tokyo_tower_q_norm, "src/houses/tokyo_tower/gfx/norm_sapporo.png") {template_house_norm(255,1)}
        spriteset (spr_tokyo_tower_q_snow, "src/houses/tokyo_tower/gfx/snow_sapporo.png") {template_house_norm(255,1)}


// Spritelayouts for tokyo_tower

// E variant | P level | Norm
    spritelayout sprlay_tokyo_tower_e_p_norm {
        ground {
            sprite:        spr_tokyo_tower_p_ground_norm(2);
        }
        building {
            sprite:        spr_tokyo_tower_p_norm (2);
        }
    }

// E variant | P level | Snow
    spritelayout sprlay_tokyo_tower_e_p_snow {
        ground {
            sprite:        spr_tokyo_tower_p_ground_snow(2);
        }
        building {
            sprite:        spr_tokyo_tower_p_snow (2);
        }
    }

// E variant | Q level | Norm
