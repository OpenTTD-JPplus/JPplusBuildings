// Random Switches
    // Building Colours
        switch (FEAT_HOUSES, SELF, mori_t_build_clr_new, getbits(random_bits, 1, 3)) {
            0:  return 16;
            1:  return 31;
            2:  return 32;
            3:  return 45;
            4:  return 62;
            5:  return 64;
            6:  return 74;
                return 84;
        }
        switch (FEAT_HOUSES, SELF, mori_t_build_clr_old, getbits(random_bits, 1, 3)) {
            0:  return 31;
            1:  return 32;
            2:  return 45;
            3:  return 65;
            4:  return 67;
            5:  return 73;
            6:  return 74;
                return 77;
        }
    // Lefty Colours
        switch (FEAT_HOUSES, SELF, mori_t_lefty_new, getbits(random_bits, 2, 3)) {
            0:  return 35;
            1:  return 36;
            2:  return 48;
            3:  return 49;
            4:  return 64;
            5:  return 65;
            6:  return 67;
                return 77;
        }
        switch (FEAT_HOUSES, SELF, mori_t_lefty_old, getbits(random_bits, 2, 3)) {
            0:  return 35;
            1:  return 36;
            2:  return 49;
            3:  return 58;
            4:  return 65;
