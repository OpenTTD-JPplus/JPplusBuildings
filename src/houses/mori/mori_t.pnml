// Spritelayouts for mori_t

// A variant | LO level | Norm
    spritelayout sprlay_mori_t_a_lo_norm {
        ground {
            sprite:        spr_mori_t_a_lo_ground_norm(LOAD_TEMP(2));
        }
        building {
            sprite:        spr_mori_t_a_lo_norm (LOAD_TEMP(0));
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(1);
        }
        childsprite { // lefty
            sprite:        spr_mori_t_a_lo_lefty_norm (LOAD_TEMP(0)); 
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(15);
        }
        childsprite { // right
            sprite:        spr_mori_t_a_lo_right_norm (LOAD_TEMP(0)); 
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(17);
        }
        childsprite { // front
            sprite:        spr_mori_t_a_lo_front_norm (LOAD_TEMP(0)); 
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(19);
        }
    }

