// Spritelayouts for shotengai_2

// A variant | L level | Norm
    spritelayout sprlay_shotengai_2_a_L_norm {
        ground {
            sprite:        spr_shotengai_2_a_ground_norm(LOAD_TEMP(2));
        }
        building {
            sprite:        spr_shotengai_2_a_L_norm (construction_state);
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(1);
        }
        childsprite { // lefty
            sprite:        spr_shotengai_2_a_lefty_norm (construction_state); 
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(15);
        }
        childsprite { // front
            sprite:        spr_shotengai_2_a_front_norm (construction_state); 
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(19);
        }
        childsprite { // signs
            sprite:        spr_shotengai_2_a_signs (3); 
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(9);
            hide_sprite:  construction_state != 3;
        }
        childsprite { // fence
            sprite:        spr_shotengai_2_a_fence (LOAD_TEMP(4)); 
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(5);
            always_draw:  1;
            hide_sprite:  construction_state != 3;
        }
    }

