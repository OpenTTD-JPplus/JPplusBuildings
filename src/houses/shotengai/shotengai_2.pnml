// Spritelayout Switches
    // a
        // L
            switch (FEAT_HOUSES,SELF, switch_shotengai_2_a_L_sprites, [ 
                STORE_TEMP((current_year - age) < 1959 ? shotengai_2_build_clr_old() : shotengai_2_build_clr_new(),1), 
                STORE_TEMP((current_year - age) < 1945 ? shotengai_2_lefty_old() : shotengai_2_lefty_new(), 15), 
                STORE_TEMP((current_year - age) < 1945 ? shotengai_2_front_old() : shotengai_2_front_new(), 19), 
                STORE_TEMP(shotengai_2_signs_new(), 9), 
                STORE_TEMP(shotengai_2_fence_new(), 5), 
                STORE_TEMP(GroundAlley(), 2), 
                STORE_TEMP(FrontalFence(), 4),
                terrain_type == TILETYPE_SNOW])
                {1: sprlay_shotengai_2_a_L_snow; sprlay_shotengai_2_a_L_norm; } 
    // b
        // L
            switch (FEAT_HOUSES,SELF, switch_shotengai_2_b_L_sprites, [ 
                STORE_TEMP((current_year - age) < 1959 ? shotengai_2_build_clr_old() : shotengai_2_build_clr_new(),1), 
                STORE_TEMP((current_year - age) < 1945 ? shotengai_2_lefty_old() : shotengai_2_lefty_new(), 15), 
