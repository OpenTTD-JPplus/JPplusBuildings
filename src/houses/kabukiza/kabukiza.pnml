// Ground

        spriteset (spr_kabukiza_e_ground_norm, "src/houses/kabukiza/gfx/ground_norm.png") {template_ground_norm(100,3)}
        spriteset (spr_kabukiza_e_ground_snow, "src/houses/kabukiza/gfx/ground_snow.png") {template_ground_norm(100,3)}
        spriteset (spr_kabukiza_n_ground_norm, "src/houses/kabukiza/gfx/ground_norm.png") {template_ground_norm(100,4)}
        spriteset (spr_kabukiza_n_ground_snow, "src/houses/kabukiza/gfx/ground_snow.png") {template_ground_norm(100,4)}
        spriteset (spr_kabukiza_s_ground_norm, "src/houses/kabukiza/gfx/ground_norm.png") {template_ground_norm(100,2)}
        spriteset (spr_kabukiza_s_ground_snow, "src/houses/kabukiza/gfx/ground_snow.png") {template_ground_norm(100,2)}
        spriteset (spr_kabukiza_w_ground_norm, "src/houses/kabukiza/gfx/ground_norm.png") {template_ground_norm(100,1)}
