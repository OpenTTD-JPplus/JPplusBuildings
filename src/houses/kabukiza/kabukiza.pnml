// Buildings

    // L
        spriteset (spr_kabukiza_L_norm, "src/houses/kabukiza/gfx/norm.png") {template_house_norm(100,1)}
        spriteset (spr_kabukiza_L_snow, "src/houses/kabukiza/gfx/snow.png") {template_house_norm(100,1)}


// Spritelayouts for kabukiza

// E variant | L level | Norm
    spritelayout sprlay_kabukiza_e_L_norm {
        ground {
            sprite:        spr_kabukiza_e_ground_norm(LOAD_TEMP(2));
        }
        building {
            sprite:        spr_kabukiza_L_norm (2);
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(1);
        }
    }

// E variant | L level | Snow
    spritelayout sprlay_kabukiza_e_L_snow {
