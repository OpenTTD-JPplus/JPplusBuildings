// Random Switches
    // Building Colours
        switch (FEAT_HOUSES, SELF, kabukiza_build_clr_new, getbits(random_bits, 1, 2)) {
            0:  return 44;
            1:  return 45;
            2:  return 53;
                return 72;
        }


// Spritelayout Switches
    // e
        // L
            switch (FEAT_HOUSES,SELF, switch_kabukiza_e_sprites, [ 
                STORE_TEMP(kabukiza_build_clr_new(), 1), 
                STORE_TEMP(GroundAlley(), 2),
                terrain_type == TILETYPE_SNOW])
                {1: sprlay_kabukiza_e_L_snow; sprlay_kabukiza_e_L_norm; } 
    // n
        // L
            switch (FEAT_HOUSES,SELF, switch_kabukiza_n_sprites, [ 
                STORE_TEMP(kabukiza_build_clr_new(), 1), 
                STORE_TEMP(GroundAlley(), 2),
                terrain_type == TILETYPE_SNOW])
                {1: sprlay_kabukiza_n_L_snow; sprlay_kabukiza_n_L_norm; } 
    // s
        // L
            switch (FEAT_HOUSES,SELF, switch_kabukiza_s_sprites, [ 
                STORE_TEMP(kabukiza_build_clr_new(), 1), 
                STORE_TEMP(GroundAlley(), 2),
                terrain_type == TILETYPE_SNOW])
                {1: sprlay_kabukiza_s_L_snow; sprlay_kabukiza_s_L_norm; } 
    // w
        // L
            switch (FEAT_HOUSES,SELF, switch_kabukiza_w_sprites, [ 
                STORE_TEMP(kabukiza_build_clr_new(), 1), 
                STORE_TEMP(GroundAlley(), 2),
                terrain_type == TILETYPE_SNOW])
                {1: sprlay_kabukiza_w_L_snow; sprlay_kabukiza_w_L_norm; } 

// Item Block
    item(FEAT_HOUSES, item_kabukiza, 66, HOUSE_SIZE_2X2){
        property {
            substitute:              20;
            name:                    string(NAME_KABUKIZA);
            population:              100;
            accepted_cargos:         [[PASS, 8],[MAIL, 1],[FOOD, 2]];
            local_authority_impact:  80;
            removal_cost_multiplier: 80;
            probability:             1;
            years_available:         [1870,0xFFFF];
            minimum_lifetime:        20;
            availability_mask:       [bitmask(TOWNZONE_CENTRE), bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPIC, ABOVE_SNOWLINE)];
            building_class:          3;
            building_flags:          bitmask(HOUSE_FLAG_NOT_SLOPED,HOUSE_FLAG_PROTECTED);
        }
        graphics {
            graphics_north:          switch_kabukiza_n_sprites;
            graphics_east:           switch_kabukiza_e_sprites;
            graphics_west:           switch_kabukiza_w_sprites;
            graphics_south:          switch_kabukiza_s_sprites;
            construction_check:      switch_kabuki_con_check;
            cargo_production:        func_produce(10,2);
        }
    }