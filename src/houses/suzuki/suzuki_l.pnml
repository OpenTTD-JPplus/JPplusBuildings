// Spritelayouts for suzuki_l

// A variant | 8L level | Norm
    spritelayout sprlay_suzuki_l_a_8L_norm {
        ground {
            sprite:        spr_suzuki_l_a_ground_norm(LOAD_TEMP(2));
        }
        building {
            sprite:        spr_suzuki_l_a_8L_norm (LOAD_TEMP(0));
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(1);
        }
        childsprite { // lefty
            sprite:        spr_suzuki_l_a_lefty_norm (LOAD_TEMP(0)); 
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(15);
        }
        childsprite { // right
            sprite:        spr_suzuki_l_a_right_norm (LOAD_TEMP(0)); 
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(17);
        }
        childsprite { // front
            sprite:        spr_suzuki_l_a_front_norm (LOAD_TEMP(0)); 
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(19);
        }
        childsprite { // signs
            sprite:        spr_suzuki_l_a_signs (LOAD_TEMP(8)); 
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(9);
            hide_sprite:  construction_state != 3;
        }
    }

