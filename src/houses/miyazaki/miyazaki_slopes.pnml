    // Building Colours
        switch (FEAT_HOUSES, SELF, miyazaki_slopes_build_clr_new, getbits(random_bits, 1, 4)) {
            0:  return 15;
            1:  return 22;
            2:  return 23;
            3:  return 31;
            4:  return 32;
            5:  return 34;
