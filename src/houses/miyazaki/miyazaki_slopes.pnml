// Spritelayout Switches
    // h
        // L
            switch (FEAT_HOUSES,SELF, switch_miyazaki_slopes_h_L_norm_diagonal_sprites, [ 
                STORE_TEMP((current_year - age) < 1945 ? miyazaki_slopes_build_clr_old() : miyazaki_slopes_build_clr_new(),1), 
                STORE_TEMP(miyazaki_slopes_fence_new(), 5), 
                STORE_TEMP(GroundSlopes(), 2), 
                STORE_TEMP(Season(), 10),
                terrain_type == TILETYPE_SNOW])
                {1: sprlay_miyazaki_slopes_h_L_diagonal_snow; sprlay_miyazaki_slopes_h_L_diagonal_norm; } 

            switch (FEAT_HOUSES,SELF, switch_miyazaki_slopes_h_L_norm_oneup_sprites, [ 
                STORE_TEMP((current_year - age) < 1945 ? miyazaki_slopes_build_clr_old() : miyazaki_slopes_build_clr_new(),1), 
                STORE_TEMP(miyazaki_slopes_fence_new(), 5), 
                STORE_TEMP(GroundSlopes(), 2), 
