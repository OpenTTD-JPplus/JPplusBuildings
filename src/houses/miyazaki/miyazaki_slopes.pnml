            switch (FEAT_HOUSES,SELF, switch_miyazaki_slopes_h_L_norm_valley_sprites, [ 
                STORE_TEMP((current_year - age) < 1945 ? miyazaki_slopes_build_clr_old() : miyazaki_slopes_build_clr_new(),1), 
