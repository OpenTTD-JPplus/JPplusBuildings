// Spritelayouts for miyazaki_slopes

// H variant | L level | Norm
    spritelayout sprlay_miyazaki_slopes_h_L_diagonal_norm {
        ground {
            sprite:        spr_miyazaki_slopes_h_L_ground_diagonal_norm(LOAD_TEMP(2));
        }
        building {
            sprite:        spr_miyazaki_slopes_h_L_diagonal_norm (LOAD_TEMP(2));
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(1);
        }
        childsprite { // fence
            sprite:        spr_miyazaki_slopes_h_diagonal_fence (LOAD_TEMP(2)); 
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(5);
            hide_sprite:  construction_state != 3;
        }
        childsprite { // trees
            sprite:        spr_miyazaki_slopes_h_diagonal_trees (LOAD_TEMP(10)); 
            hide_sprite:  construction_state != 3;
        }
        childsprite { // front
            sprite:        spr_miyazaki_slopes_h_diagonal_front (LOAD_TEMP(2)); 
            recolour_mode: RECOLOUR_REMAP;
            palette:       recolour_remap + LOAD_TEMP(5);
            hide_sprite:  construction_state != 3;
        }
    }

