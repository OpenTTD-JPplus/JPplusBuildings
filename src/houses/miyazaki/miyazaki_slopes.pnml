                STORE_TEMP(miyazaki_slopes_fence_new(), 5), 
                STORE_TEMP(GroundSlopes(), 2), 
                STORE_TEMP(Season(), 10),
                terrain_type == TILETYPE_SNOW])
                {1: sprlay_miyazaki_slopes_h_L_onedown_snow; sprlay_miyazaki_slopes_h_L_onedown_norm; } 

    // Which slope sprite to use
    switch (FEAT_HOUSES,SELF,switch_miyazaki_slopes_sprites, nearby_tile_slope(0,0)  ) {
        SLOPE_W:   switch_miyazaki_slopes_h_L_norm_oneup_sprites;
        SLOPE_S:   switch_miyazaki_slopes_h_L_norm_oneup_sprites;
        SLOPE_E:   switch_miyazaki_slopes_h_L_norm_oneup_sprites;
        SLOPE_N:   switch_miyazaki_slopes_h_L_norm_oneup_sprites;
        SLOPE_SW:  switch_miyazaki_slopes_h_L_norm_diagonal_sprites;
        SLOPE_SE:  switch_miyazaki_slopes_h_L_norm_diagonal_sprites;
        SLOPE_NW:  switch_miyazaki_slopes_h_L_norm_diagonal_sprites;
        SLOPE_NE:  switch_miyazaki_slopes_h_L_norm_diagonal_sprites;
        SLOPE_EW:  switch_miyazaki_slopes_h_L_norm_valley_sprites;
        SLOPE_NS:  switch_miyazaki_slopes_h_L_norm_valley_sprites;
        SLOPE_NWS: switch_miyazaki_slopes_h_L_norm_onedown_sprites;
        SLOPE_WSE: switch_miyazaki_slopes_h_L_norm_onedown_sprites;
        SLOPE_SEN: switch_miyazaki_slopes_h_L_norm_onedown_sprites;
        SLOPE_ENW: switch_miyazaki_slopes_h_L_norm_onedown_sprites;
        SLOPE_FLAT:switch_miyazaki_slopes_h_L_norm_valley_sprites;
        switch_miyazaki_slopes_h_L_norm_diagonal_sprites;
    }


// Item Block
    item(FEAT_HOUSES, item_miyazaki_slopes, 63, HOUSE_SIZE_1X1){
        property {
            substitute:              6;
            name:                    string(NAME_MIYAZAKI_SLOPES);
            population:              20;
            accepted_cargos:         [[PASS, 4],[MAIL, 2]];
            local_authority_impact:  80;
            removal_cost_multiplier: 80;
            probability:             1;
            years_available:         [1900,0xFFFF];
            minimum_lifetime:        5;
            availability_mask:       [bitmask(TOWNZONE_EDGE, TOWNZONE_OUTSKIRT, TOWNZONE_OUTER_SUBURB), bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPIC, ABOVE_SNOWLINE)];
            building_class:          0;
        }
        graphics {
            default:                 switch_miyazaki_slopes_sprites;
            foundations:             CB_RESULT_NO_FOUNDATIONS;
            construction_check:      SlopesNotByTheSea;
            cargo_production:        func_produce(3,1);
        }
    }